rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validPlaylist(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.description is string
        && data.description.size() <= 160;
    }

    function validPlaylistItem(data) {
      return data.slug is string
        && data.slug.size() > 0
        && data.slug.size() <= 120
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.img is string
        && data.img.size() <= 2048
        && data.url is string
        && data.url.size() <= 2048;
    }

    function validNotification(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.message is string
        && data.message.size() <= 1000
        && data.type is string
        && data.type.size() <= 40
        && data.read is bool;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validProgress(data) {
      return data.contentId is string
        && data.contentId.size() > 0
        && data.slug is string
        && data.slug.size() > 0
        && data.episodeNumber is int
        && data.episodeNumber > 0
        && data.position is number
        && data.position >= 0
        && data.duration is number
        && data.duration >= 0
        && data.percent is number
        && data.percent >= 0
        && data.percent <= 100
        && data.completed is bool;
    }

    function validCatalog(data) {
      return data.contentId is string
        && data.contentId.size() > 0
        && data.slug is string
        && data.slug.size() > 0
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200;
    }

    function validEpisode(data) {
      return data.episodeNumber is int
        && data.episodeNumber > 0
        && data.title is string
        && data.title.size() > 0
        && (!('videoUrl' in data) || data.videoUrl == null || data.videoUrl is string)
        && (!('thumbnail' in data) || data.thumbnail == null || data.thumbnail is string);
    }

    function validUserCreate(data) {
      return !('role' in data);
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId) && validUserCreate(request.resource.data);
      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'createdAt'
        ]);

      match /favourites/{favouriteId} {
        allow read, write: if ownsUser(userId);
      }

      match /history/{historyId} {
        allow read, write: if ownsUser(userId);
      }

      match /progress/{progressId} {
        allow read, create, update: if ownsUser(userId) && validProgress(request.resource.data);
        allow delete: if ownsUser(userId);
      }

      match /playlists/{playlistId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && validPlaylist(request.resource.data);
        allow update: if ownsUser(userId) && validPlaylist(request.resource.data);
        allow delete: if ownsUser(userId);

        match /items/{itemId} {
          allow read: if ownsUser(userId);
          allow create, update: if ownsUser(userId) && validPlaylistItem(request.resource.data);
          allow delete: if ownsUser(userId);
        }
      }

      match /notifications/{notificationId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && validNotification(request.resource.data);
        allow update: if ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read is bool;
        allow delete: if ownsUser(userId);
      }
    }

    match /catalog/{contentId} {
      allow read: if true;
      allow create, update: if isAdmin() && validCatalog(request.resource.data);
      allow delete: if isAdmin();

      match /episodes/{episodeId} {
        allow read: if true;
        allow create, update: if isAdmin() && validEpisode(request.resource.data);
        allow delete: if isAdmin();
      }
    }
  }
}